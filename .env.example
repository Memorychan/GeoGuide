# Server Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration
# Default: Local embedded SQLite with WAL mode
DATABASE_URL=sqlite://geoguide.db?mode=rwc
# For PostgreSQL in production:
# DATABASE_URL=postgres://postgres:password@localhost:5432/geoguide

# Security & Cryptography
JWT_SECRET=geoguide_super_secure_jwt_secret_key_change_in_production_2026!
JWT_ACCESS_EXPIRY_MINS=15
REFRESH_EXPIRY_DAYS=7
ADMIN_REGISTRATION_SECRET=geoguide_admin_secret_key_2026

# Movement Notification Engine
# Distance displacement threshold in meters to trigger an admin movement alert
DEFAULT_MOVEMENT_THRESHOLD_METERS=25.0

